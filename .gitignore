# ═══════════════════════════════════════════════════════════
# 🔒 Laravel .gitignore — إصدار آمن
# ═══════════════════════════════════════════════════════════

# ═══ Laravel Core ═══
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/vendor
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# ═══ Environment (حساس!) ═══
.env
.env.*
!.env.example
.env.backup
.env.backup.*
.env.production

# ═══ 🔑 ملفات حساسة ═══
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
storage/vapid/
storage/oauth/
storage/keys/

# ═══ 🔒 Backups and Versions ═══
*.bak
*.bak.*
*.bak-*
*.backup
*.backup.*
*.before-*
*.before-*
*.broken-*
*.broken.*
*.old
*.orig
*~
storage/backups/

# ═══ 📦 Compressed / Archives ═══
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# ═══ 📹 Media (كبيرة) ═══
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv

# ═══ 🗄️ Database ═══
/database/database.sqlite
/database/*.sqlite
/database/*.sqlite-journal

# ═══ 🧪 Test Files ═══
/fresh-test
/tests
phpunit.xml
/test*.php

# ═══ 🔧 Scripts (غير ضرورية) ═══
add_*.php
fix_*.php
regen_*.php
redesign_*.php
generate_*.py
create_*.py
update_*.php
generate_*.php
seed_*.php
*.sh.bak

# ═══ 📝 Logs / Cache ═══
/bootstrap/cache/*
/storage/framework/testing/*
/storage/framework/views/*

# ═══ 🎨 Editor ═══
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ═══ 📋 OS Files ═══
.DS_Store
._*
.Spotlight-V100
.Trashes

# ═══ 🔧 إضافات ═══
*.backup-*
*.backup.*
*.bak-*

# ═══ Cleanup patterns (2026-09-28) ═══
*.bak
*.bak[0-9]*
*.bak-*
*.broken*
*.broken-*
*.before-*
*.old
*.backup
*.sqlite.backup.*
*.sqlite.bak-*
/fresh-test/
multistore-trash-*
sms-forwarder.sh
